# Canonical origin of the public site (no trailing slash). Drives canonical URLs,
# Open Graph, JSON-LD, sitemap and robots.txt. Placeholder default when unset.
SITE_URL=https://leadergroup.example

# Stock endpoint (server-only, read at build time; never use the PUBLIC_ prefix).
# Leave STOCK_API_URL unset to build with the local fixture in src/data/stock-fixture.ts.
# When it is set and the request fails, the build fails on purpose.
STOCK_API_URL=
# Optional key sent as `apikey` and `Authorization: Bearer` headers (Supabase anon key).
STOCK_API_KEY=
