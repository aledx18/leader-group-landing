---
import Icon from "@/components/Icon.astro";

interface Props {
  href: string;
  label?: string;
}

const { href, label = "Consultar por WhatsApp" } = Astro.props;
---

<a
  href={href}
  rel="noopener"
  target="_blank"
  class="fixed right-4 bottom-4 z-30 inline-flex h-14 items-center gap-2 rounded-full bg-brand px-5 font-semibold text-white shadow-lg shadow-black/30 hover:bg-brand-strong md:right-6 md:bottom-6"
  style="margin-bottom: env(safe-area-inset-bottom);"
>
  <Icon name="message-circle" size={22} />
  <span>WhatsApp</span>
  <span class="sr-only">: {label}</span>
</a>
