---
import Icon from "@/components/Icon.astro";
import VehiclePhoto from "@/components/VehiclePhoto.astro";
import { formatPrice } from "@/lib/format";
import { contactLink } from "@/lib/contact";
import type { Vehicle } from "@/lib/stock";
import { vehicleInquiryMessage } from "@/lib/whatsapp";

interface Props {
  vehicle: Vehicle;
  /** Image sizes hint, depends on the grid. */
  sizes: string;
  eager?: boolean;
}

const { vehicle, sizes, eager = false } = Astro.props;
const path = `/autos/${vehicle.slug}/`;
const pageUrl = new URL(path, Astro.site).href;
---

<article
  class="group relative flex flex-col overflow-hidden rounded-xl border border-line bg-paper shadow-sm transition-shadow hover:shadow-lg"
>
  <div class="relative overflow-hidden bg-night">
    <VehiclePhoto
      photo={vehicle.photos[0]}
      alt={`Foto de ${vehicle.name}`}
      sizes={sizes}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </div>

  <div class="flex flex-1 flex-col gap-4 p-4 sm:p-5">
    <h3 class="font-display text-[19px] leading-tight font-extrabold text-ink sm:text-xl">
      <a href={path} class="after:absolute after:inset-0 after:content-['']">
        {vehicle.name}
      </a>
    </h3>

    <div class="mt-auto flex items-end justify-between gap-3 border-t border-line pt-4">
      <p class="flex flex-col gap-0.5">
        <span class="text-xs text-ink-soft">Precio contado</span>
        <span class="font-display text-[22px] leading-none font-black whitespace-nowrap text-ink">
          {formatPrice(vehicle.price, vehicle.currency)}
        </span>
      </p>
      <a
        href={contactLink(vehicleInquiryMessage(vehicle.name, pageUrl))}
        rel="noopener"
        target="_blank"
        class="relative z-10 inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-lg bg-brand px-4 text-sm font-semibold text-white hover:bg-brand-strong"
      >
        Consultar
        <Icon name="arrow-up-right" size={16} />
        <span class="sr-only">por {vehicle.name} en WhatsApp</span>
      </a>
    </div>
  </div>
</article>
