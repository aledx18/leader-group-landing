---
import Icon, { type IconName } from "@/components/Icon.astro";

const reasons: { icon: IconName; title: string; text: string }[] = [
  {
    icon: "shield-check",
    title: "Peritaje de 120 puntos",
    text: "Cada auto pasa por mecánica, chapa y electrónica antes de publicarse.",
  },
  {
    icon: "file-check",
    title: "Papeles al día",
    text: "Verificamos dominio, multas e informes. Transferencia en el día.",
  },
  {
    icon: "badge-check",
    title: "Garantía escrita",
    text: "3 meses de garantía mecánica en motor y caja en todas las unidades.",
  },
  {
    icon: "key",
    title: "Prueba sin compromiso",
    text: "Agenda tu test drive por WhatsApp y maneja antes de decidir.",
  },
];
---

<section class="bg-paper py-12 md:py-20" aria-labelledby="why-title">
  <div class="container-page grid gap-7 md:grid-cols-[1fr_1.2fr] md:gap-12">
    <div class="flex flex-col gap-2.5">
      <p class="eyebrow text-brand-strong">Por qué Leader</p>
      <h2 id="why-title" class="font-display text-[28px] leading-[1.08] font-black md:text-4xl">
        Comprar un usado no tiene por qué ser una apuesta.
      </h2>
    </div>
    <ul class="flex flex-col">
      {
        reasons.map((reason) => (
          <li class="flex gap-4 border-t border-line py-[18px] last:border-b">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-brand/10 text-brand">
              <Icon name={reason.icon} size={22} />
            </span>
            <div class="flex flex-col gap-1">
              <h3 class="font-display text-[17px] font-extrabold">{reason.title}</h3>
              <p class="text-sm leading-relaxed text-ink-soft">{reason.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
