---
import { Image } from "astro:assets";
import logoMark from "@/assets/brand/logo-mark.png";
import Icon from "@/components/Icon.astro";
import { business } from "@/config/business";
import { contactLink } from "@/lib/contact";

interface Props {
  vehicleCount: number;
}

const { vehicleCount } = Astro.props;
const countLabel =
  vehicleCount === 1 ? "1 auto disponible hoy" : `${vehicleCount} autos disponibles hoy`;
---

<section
  class="relative isolate overflow-hidden bg-night text-white"
  aria-labelledby="hero-title"
>
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(120%_70%_at_85%_20%,rgba(20,109,212,0.35),transparent_60%),radial-gradient(90%_60%_at_0%_100%,rgba(30,222,241,0.12),transparent_65%)]"
    aria-hidden="true"
  >
  </div>
  <Image
    src={logoMark}
    alt=""
    width={483}
    height={87}
    loading="eager"
    class="pointer-events-none absolute top-24 -right-24 -z-10 w-[130%] max-w-none opacity-20 md:top-16 md:right-0 md:w-[60%]"
  />

  <div class="container-page flex flex-col gap-6 pt-16 pb-8 md:pt-24 md:pb-14">
    {
      vehicleCount > 0 && (
        <p class="inline-flex w-fit items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-[13px] font-medium">
          <span class="relative flex size-2" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-cyan opacity-60 motion-reduce:animate-none" />
            <span class="relative inline-flex size-2 rounded-full bg-cyan" />
          </span>
          {countLabel}
        </p>
      )
    }

    <h1
      id="hero-title"
      class="max-w-2xl font-display text-[2.75rem] leading-[0.98] font-black tracking-tight text-balance sm:text-6xl md:text-7xl"
    >
      Tu próximo auto, sin vueltas.
    </h1>

    <p class="max-w-xl text-base leading-relaxed text-white/80 md:text-lg">
      Usados revisados, con papeles al día y precio claro desde el primer mensaje. Elige, pruébalo
      y llévatelo.
    </p>

    <div class="flex flex-col gap-2.5 sm:flex-row">
      <a href="#stock" class="btn bg-brand text-white hover:bg-brand-strong">
        Ver autos disponibles
        <Icon name="arrow-right" size={20} />
      </a>
      <a
        href={contactLink(business.messages.general)}
        rel="noopener"
        target="_blank"
        class="btn border border-white/25 font-semibold text-white hover:border-cyan"
      >
        <Icon name="message-circle" size={20} />
        Consultar por WhatsApp
      </a>
    </div>

    <dl class="mt-2 grid grid-cols-3 gap-3 border-t border-white/15 pt-5 md:max-w-xl">
      {
        business.stats.map((stat) => (
          <div class="flex flex-col-reverse gap-0.5">
            <dt class="text-xs text-white/70">{stat.label}</dt>
            <dd class="font-display text-[22px] leading-tight font-extrabold">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
