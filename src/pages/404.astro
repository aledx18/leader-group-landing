---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Página no encontrada | Leader Group"
  description="Esta página no existe o fue movida."
  noindex
  bodyClass="bg-night text-white"
>
  <section
    class="container-page flex min-h-[70dvh] flex-col items-center justify-center gap-6 py-16 text-center"
  >
    <p class="font-display text-7xl font-black text-cyan" aria-hidden="true">404</p>
    <div class="flex max-w-md flex-col gap-2">
      <h1 class="font-display text-2xl font-black">Página no encontrada</h1>
      <p class="text-night-muted">
        La página que buscas no existe o puede que el auto ya se haya vendido.
      </p>
    </div>
    <a href="/" class="btn bg-brand text-white hover:bg-brand-strong">Volver al inicio</a>
  </section>
</Layout>
