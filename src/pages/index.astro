---
import Layout from "@/layouts/Layout.astro";
import { getStock } from "@/lib/stock";

const { vehicles } = await getStock();
---

<Layout bodyClass="bg-night text-white">
  <section class="container-page py-16">
    <h1 class="font-display text-4xl font-black">Leader Group</h1>
    <p>{vehicles.length} autos disponibles</p>
  </section>
</Layout>
